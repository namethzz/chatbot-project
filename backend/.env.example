# MongoDB — ในเครื่องใช้ localhost, ตอน deploy ใช้ URI ของ MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/agri_chatbot

# Port ของ backend (Render ตั้งให้เอง)
PORT=4000

# URL ของ RAG API — ในเครื่องใช้ localhost, ตอน deploy ใช้ https://<user>-<space>.hf.space/ask
RAG_API_URL=http://localhost:8000/ask

# ต้องตรงกับ RAG_API_KEY ที่ตั้งใน Hugging Face Space (เว้นว่างได้ถ้า RAG ไม่ได้ตั้ง)
RAG_API_KEY=

# URL ของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย ,)
CORS_ORIGINS=http://localhost:5173
